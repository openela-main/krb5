From 7b5916db21266a09659c154758795ec224fda36e Mon Sep 17 00:00:00 2001
From: Julien Rische <jrische@redhat.com>
Date: Thu, 3 Sep 2026 18:27:50 +0200
Subject: [PATCH 82/89] Fix memory leak in auth_gssapi_wrap_data()

In auth_gssapi_wrap_data(), use a cleanup handler to ensure that
out_buf is freed along all exit paths.

[ghudson@mit.edu: added initializer for out_buf; made out_buf cleanup
unconditional; minor style edits; rewrote commit message]

ticket: 9264 (new)
tags: pullup
target_version: 1.22-next

(cherry picked from commit af2bef94432e11ff73962f6ec893c835050d69d7)
---
 src/lib/rpc/auth_gssapi_misc.c | 26 ++++++++++++--------------
 1 file changed, 12 insertions(+), 14 deletions(-)

diff --git a/src/lib/rpc/auth_gssapi_misc.c b/src/lib/rpc/auth_gssapi_misc.c
index 72ae57aa0d..63db6dcc62 100644
--- a/src/lib/rpc/auth_gssapi_misc.c
+++ b/src/lib/rpc/auth_gssapi_misc.c
@@ -196,11 +196,12 @@ bool_t auth_gssapi_wrap_data(
      xdrproc_t xdr_func,
      caddr_t xdr_ptr)
 {
-     gss_buffer_desc in_buf, out_buf;
+     gss_buffer_desc in_buf, out_buf = { 0 };
      XDR temp_xdrs;
      int conf_state;
      unsigned int length;
      char *cp;
+     bool_t success = FALSE;
 
      PRINTF(("gssapi_wrap_data: starting\n"));
 
@@ -213,15 +214,13 @@ bool_t auth_gssapi_wrap_data(
      PRINTF(("gssapi_wrap_data: encoding seq_num %d\n", seq_num));
      if (! xdr_u_int32(&temp_xdrs, &seq_num)) {
 	  PRINTF(("gssapi_wrap_data: serializing seq_num failed\n"));
-	  XDR_DESTROY(&temp_xdrs);
-	  return FALSE;
+	  goto cleanup;
      }
 
      /* serialize the arguments into local memory */
      if (!(*xdr_func)(&temp_xdrs, xdr_ptr)) {
 	  PRINTF(("gssapi_wrap_data: serializing arguments failed\n"));
-	  XDR_DESTROY(&temp_xdrs);
-	  return FALSE;
+	  goto cleanup;
      }
 
      in_buf.length = xdr_getpos(&temp_xdrs);
@@ -230,10 +229,8 @@ bool_t auth_gssapi_wrap_data(
      *major = gss_seal(minor, context, 1,
 		       GSS_C_QOP_DEFAULT, &in_buf, &conf_state,
 		       &out_buf);
-     if (*major != GSS_S_COMPLETE) {
-	  XDR_DESTROY(&temp_xdrs);
-	  return FALSE;
-     }
+     if (*major != GSS_S_COMPLETE)
+	  goto cleanup;
 
      PRINTF(("gssapi_wrap_data: %d bytes data, %d bytes sealed\n",
 	     (int) in_buf.length, (int) out_buf.length));
@@ -243,16 +240,17 @@ bool_t auth_gssapi_wrap_data(
      cp = out_buf.value;
      if (! xdr_bytes(out_xdrs, &cp, &length, out_buf.length)) {
 	  PRINTF(("gssapi_wrap_data: serializing encrypted data failed\n"));
-	  XDR_DESTROY(&temp_xdrs);
-	  return FALSE;
+	  goto cleanup;
      }
      out_buf.value = cp;
 
-     *major = gss_release_buffer(minor, &out_buf);
-
      PRINTF(("gssapi_wrap_data: succeeding\n\n"));
+     success = TRUE;
+
+cleanup:
+     gss_release_buffer(minor, &out_buf);
      XDR_DESTROY(&temp_xdrs);
-     return TRUE;
+     return success;
 }
 
 bool_t auth_gssapi_unwrap_data(
-- 
2.53.0

