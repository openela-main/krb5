+		if (BT_STACKFULL(t))
+			return (NULL);
 	}
 }
 
diff --git a/src/plugins/kdb/db2/libdb2/btree/bt_seq.c b/src/plugins/kdb/db2/libdb2/btree/bt_seq.c
