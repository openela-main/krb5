From 55c5f72f49484562b5784bb102fe3f67f4ee2e32 Mon Sep 17 00:00:00 2001
From: Julien Rische <jrische@redhat.com>
Date: Fri, 4 Sep 2026 12:17:34 +0200
Subject: [PATCH 87/90] Fix leak on error in process_chpw_request()

In process_chpw_request(), wipe the "clear" buffer before reusing it
in the chpwfail label.

[ghudson@mit.edu: removed conditionalization on wipe operation; edited
comment; rewrote commit message]

ticket: 9263 (new)
tags: pullup
target_version: 1.22-next

(cherry picked from commit a1ea55a6726c6a56258ae8ef523b3df9be4022f1)
---
 src/kadmin/server/schpw.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/kadmin/server/schpw.c b/src/kadmin/server/schpw.c
index a186e0fa15..c5ea12e624 100644
--- a/src/kadmin/server/schpw.c
+++ b/src/kadmin/server/schpw.c
@@ -306,6 +306,10 @@ process_chpw_request(krb5_context context, void *server_handle, char *realm,
 
 chpwfail:
 
+    /* Wipe any decrypted data in clear if present, and reuse it for the error
+     * message plaintext. */
+    zapfree(clear.data, clear.length);
+    clear = empty_data();
     ret = alloc_data(&clear, 2 + strlen(strresult));
     if (ret)
         goto bailout;
