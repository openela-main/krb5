From df48ae49fff317bc7235aa0cd9c08d7b3f073903 Mon Sep 17 00:00:00 2001
From: Greg Hudson <ghudson@mit.edu>
Date: Sun, 2 Aug 2026 21:39:23 -0400
Subject: [PATCH 64/89] Check for keyed checksums in CAMMAC verifiers

In libkrb5's check_svcver() and in the KDC's cammac_check_kdcver(),
return an error if the verifier uses an unkeyed checksum.

CVE-2026-71199:

In MIT krb5 release 1.14 and later (since authentication indicator
support was added), an authenticated attacker can bypass
authentication indicator requirements using an unkeyed checksum in the
CAMMAC authdata container.  Discovered by Claude and Ada Logics, and
by Alejandro Pacheco.

ticket: 9228 (new)
tags: pullup
target_version: 1.22-next

(cherry picked from commit cf8ad8b49343364a3d6e0450b7e36ff857f19d1a)
---
 src/kdc/cammac.c               | 2 +-
 src/lib/krb5/krb/cammac_util.c | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/kdc/cammac.c b/src/kdc/cammac.c
index df5fe966f2..c0d5b6f666 100644
--- a/src/kdc/cammac.c
+++ b/src/kdc/cammac.c
@@ -144,7 +144,7 @@ cammac_check_kdcver(krb5_context context, krb5_cammac *cammac,
 
     memset(&tgtkey, 0, sizeof(tgtkey));
 
-    if (ver == NULL)
+    if (ver == NULL || !krb5_c_is_keyed_cksum(ver->checksum.checksum_type))
         goto cleanup;
 
     /* Fetch the krbtgt key indicated by the KDC verifier.  Only allow the
diff --git a/src/lib/krb5/krb/cammac_util.c b/src/lib/krb5/krb/cammac_util.c
index ab9da05a78..32748e4aee 100644
--- a/src/lib/krb5/krb/cammac_util.c
+++ b/src/lib/krb5/krb/cammac_util.c
@@ -44,6 +44,8 @@ check_svcver(krb5_context context, const krb5_cammac *cammac,
 
     if (ver == NULL)
         return EINVAL;
+    if (!krb5_c_is_keyed_cksum(ver->checksum.checksum_type))
+        return KRB5KRB_AP_ERR_BAD_INTEGRITY;
 
     ret = encode_krb5_authdata(cammac->elements, &der_authdata);
     if (ret)
