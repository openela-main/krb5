From a57f59ae690c3ee354dac6add357f763224ffbf5 Mon Sep 17 00:00:00 2001
From: Julien Rische <jrische@redhat.com>
Date: Tue, 13 Oct 2026 03:56:58 -0400
Subject: [PATCH 81/90] Fix leaks when decoding GSS buffers in libgssrpc

In xdr_rpc_gss_unwrap_data(), if xdr_rpc_gss_buf() fails, free the
value we tried to decode as it may contain partial results.  Also
avoid using gss_release_buffer() on buffers not allocated by GSS APIs.

In gssrpc__svcauth_gss(), avoid leaking partial results if
xdr_rpc_gss_cred() fails.

[ghudson@mit.edu: folded in gss_release_buffer->xdr_free fixes; moved
responsibility to callers of XDR decoders; rewrote commit message]

CVE-2026-112315:

The RPCSEC_GSS authentication routines in lib/rpc/authgss_prot.c in
MIT Kerberos 5 (aka krb5) 1.4 and later do not free partially decoded
buffers on failure, which allows remote attackers to cause a denial of
service (memory leak in kadmind) via crafted RPCSEC_GSS messages.

ticket: 9256 (new)
tags: pullup
target_version: 1.22-next

(cherry picked from commit fb0fd488ef90072943060bb99f92df322dd528c5)
---
 src/lib/rpc/authgss_prot.c | 12 +++++++++---
 src/lib/rpc/svc_auth_gss.c |  6 +++---
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/src/lib/rpc/authgss_prot.c b/src/lib/rpc/authgss_prot.c
index 5edace5ebb..017fa9ae3c 100644
--- a/src/lib/rpc/authgss_prot.c
+++ b/src/lib/rpc/authgss_prot.c
@@ -209,13 +209,15 @@ xdr_rpc_gss_unwrap_data(XDR *xdrs, xdrproc_t xdr_func, caddr_t xdr_ptr,
 
 		/* Decode databody_integ. */
 		if (!xdr_rpc_gss_buf(xdrs, &databuf, mem_budget)) {
+			xdr_free((xdrproc_t)xdr_rpc_gss_buf, &databuf);
 			log_debug("xdr decode databody_integ failed");
 			return (FALSE);
 		}
 		mem_budget -= databuf.length;
 		/* Decode checksum. */
 		if (!xdr_rpc_gss_buf(xdrs, &wrapbuf, mem_budget)) {
-			gss_release_buffer(&min_stat, &databuf);
+			xdr_free((xdrproc_t)xdr_rpc_gss_buf, &wrapbuf);
+			xdr_free((xdrproc_t)xdr_rpc_gss_buf, &databuf);
 			log_debug("xdr decode checksum failed");
 			return (FALSE);
 		}
@@ -225,7 +227,7 @@ xdr_rpc_gss_unwrap_data(XDR *xdrs, xdrproc_t xdr_func, caddr_t xdr_ptr,
 		free(wrapbuf.value);
 
 		if (maj_stat != GSS_S_COMPLETE || qop_state != qop) {
-			gss_release_buffer(&min_stat, &databuf);
+			xdr_free((xdrproc_t)xdr_rpc_gss_buf, &databuf);
 			log_status("gss_verify_mic", maj_stat, min_stat);
 			return (FALSE);
 		}
@@ -233,6 +235,7 @@ xdr_rpc_gss_unwrap_data(XDR *xdrs, xdrproc_t xdr_func, caddr_t xdr_ptr,
 	else if (svc == RPCSEC_GSS_SVC_PRIVACY) {
 		/* Decode databody_priv. */
 		if (!xdr_rpc_gss_buf(xdrs, &wrapbuf, GSSRPC_MAX_MESSAGE_SIZE)) {
+			xdr_free((xdrproc_t)xdr_rpc_gss_buf, &wrapbuf);
 			log_debug("xdr decode databody_priv failed");
 			return (FALSE);
 		}
@@ -255,7 +258,10 @@ xdr_rpc_gss_unwrap_data(XDR *xdrs, xdrproc_t xdr_func, caddr_t xdr_ptr,
 	xdr_stat = (xdr_u_int32(&tmpxdrs, &seq_num) &&
 		    (*xdr_func)(&tmpxdrs, xdr_ptr));
 	XDR_DESTROY(&tmpxdrs);
-	gss_release_buffer(&min_stat, &databuf);
+	if (svc == RPCSEC_GSS_SVC_INTEGRITY)
+		xdr_free((xdrproc_t)xdr_rpc_gss_buf, &databuf);
+	else if (svc == RPCSEC_GSS_SVC_PRIVACY)
+		gss_release_buffer(&min_stat, &databuf);
 
 	/* Verify sequence number. */
 	if (xdr_stat == TRUE && seq_num != seq) {
diff --git a/src/lib/rpc/svc_auth_gss.c b/src/lib/rpc/svc_auth_gss.c
index 2d2f1d0d14..af6eb2d959 100644
--- a/src/lib/rpc/svc_auth_gss.c
+++ b/src/lib/rpc/svc_auth_gss.c
@@ -474,6 +474,8 @@ gssrpc__svcauth_gss(struct svc_req *rqst, struct rpc_msg *msg,
 	gc = (struct rpc_gss_cred *)rqst->rq_clntcred;
 	memset(gc, 0, sizeof(*gc));
 
+#define ret_freegc(code) do { retstat = code; goto freegc; } while (0)
+
 	log_debug("calling xdrmem_create()");
 	log_debug("oa_base=%p, oa_length=%u", rqst->rq_cred.oa_base,
 		  rqst->rq_cred.oa_length);
@@ -484,14 +486,12 @@ gssrpc__svcauth_gss(struct svc_req *rqst, struct rpc_msg *msg,
 	if (!xdr_rpc_gss_cred(&xdrs, gc)) {
 		log_debug("xdr_rpc_gss_cred() failed");
 		XDR_DESTROY(&xdrs);
-		return (AUTH_BADCRED);
+		ret_freegc (AUTH_BADCRED);
 	}
 	XDR_DESTROY(&xdrs);
 
 	retstat = AUTH_FAILED;
 
-#define ret_freegc(code) do { retstat = code; goto freegc; } while (0)
-
 	/* Check version. */
 	if (gc->gc_v != RPCSEC_GSS_VERSION)
 		ret_freegc (AUTH_BADCRED);
-- 
