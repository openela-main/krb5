From 91de1000bbe0c9009ffa7eb1265f4dbb94e64d49 Mon Sep 17 00:00:00 2001
From: Julien Rische <jrische@redhat.com>
Date: Wed, 8 Jul 2026 18:30:31 +0200
Subject: [PATCH 79/89] Free partial tl-data on XDR decode failure

An XDR decoder may leave allocated memory in the caller's pointer on
failure, but may not entirely leak it.  In xdr_krb5_tl_data(), free
the in-progress list and tl-data item on decode failure, as they are
stored in local variables and only assigned to *tl_data_head on
success.

[ghudson@mit.edu: rewrote patch to use goto label and xdr_free();
rewrote commit message]

CVE-2026-112316:

xdr_krb5_tl_data() in lib/kadm5/kadm_rpc_xdr.c in MIT Kerberos 5 (aka
krb5) does not free partially decoded data on failure, which allows
remote authenticated users to cause a denial of service (memory leak
in kadmind) via crafted RPC requests that trigger a decode failure.

ticket: 9255 (new)
tags: pullup
target_version: 1.22-next

(cherry picked from commit ecde2307a7b963baef81b65c9ff846a1b99fc150)
---
 src/lib/kadm5/kadm_rpc_xdr.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/lib/kadm5/kadm_rpc_xdr.c b/src/lib/kadm5/kadm_rpc_xdr.c
index 9fe3c6f5fe..9c02b7105c 100644
--- a/src/lib/kadm5/kadm_rpc_xdr.c
+++ b/src/lib/kadm5/kadm_rpc_xdr.c
@@ -302,7 +302,7 @@ xdr_krb5_key_salt_tuple(XDR *xdrs, krb5_key_salt_tuple *objp)
 
 bool_t xdr_krb5_tl_data(XDR *xdrs, krb5_tl_data **tl_data_head)
 {
-     krb5_tl_data *tl, *tl2;
+     krb5_tl_data *tl = NULL, *tl2 = NULL;
      bool_t more;
      unsigned int len;
 
@@ -340,22 +340,23 @@ bool_t xdr_krb5_tl_data(XDR *xdrs, krb5_tl_data **tl_data_head)
 	  tl = NULL;
 	  while (1) {
 	       if (!xdr_bool(xdrs, &more))
-		    return FALSE;
+		    goto decode_fail;
 	       if (more == FALSE)
 		    break;
 	       tl2 = (krb5_tl_data *) malloc(sizeof(krb5_tl_data));
 	       if (tl2 == NULL)
-		    return FALSE;
+		    goto decode_fail;
 	       memset(tl2, 0, sizeof(krb5_tl_data));
 	       if (!xdr_krb5_int16(xdrs, &tl2->tl_data_type))
-		    return FALSE;
+		    goto decode_fail;
 	       if (!xdr_bytes(xdrs, (char **)&tl2->tl_data_contents, &len,
 			      GSSRPC_MAX_ELEMENT_SIZE))
-		    return FALSE;
+		    goto decode_fail;
 	       tl2->tl_data_length = len;
 
 	       tl2->tl_data_next = tl;
 	       tl = tl2;
+	       tl2 = NULL;
 	  }
 
 	  *tl_data_head = tl;
@@ -363,6 +364,11 @@ bool_t xdr_krb5_tl_data(XDR *xdrs, krb5_tl_data **tl_data_head)
      }
 
      return TRUE;
+
+decode_fail:
+     xdr_free((xdrproc_t)xdr_krb5_tl_data, &tl);
+     xdr_free((xdrproc_t)xdr_krb5_tl_data, &tl2);
+     return FALSE;
 }
 
 bool_t
