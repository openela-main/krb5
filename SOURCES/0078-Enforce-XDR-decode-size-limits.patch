 	 temp_xdrs.x_op = XDR_FREE;
-	 (void)xdr_bytes(&temp_xdrs, &cp, &length, (unsigned int) -1);
+	 (void)xdr_bytes(&temp_xdrs, &cp, &length, GSSRPC_MAX_MESSAGE_SIZE);
 	 in_buf.value = NULL;
 	 return FALSE;
      }
